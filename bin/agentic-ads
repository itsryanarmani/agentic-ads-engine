#!/usr/bin/env node
import { execute, tools } from '../src/index.js';
try {
  let [action, ...argv] = process.argv.slice(2);
  const args = {};
  if (action === 'formats') {
    action = argv[0] === 'show' ? 'get_format' : 'list_formats';
    if (action === 'get_format') { argv.shift(); args.id = argv.shift(); }
  }
  if (action === 'plan' && argv.some(arg => arg === '--format' || arg.startsWith('--format='))) action = 'plan_format';
  const schema = tools.find(t => t.name === action)?.inputSchema;
  if (!schema) throw new Error('Use formats, list-templates, list-hooks, lint, or plan');
  while (argv.length) {
    const option = argv.shift(), separator = option.indexOf('=');
    const flag = separator < 0 ? option : option.slice(0, separator);
    const value = separator < 0 ? undefined : option.slice(separator + 1);
    if (!flag.startsWith('--')) throw new Error('Expected an option');
    const key = flag === '--dry-run' ? 'dryRun' : flag === '--cost-class' ? 'costClass' : flag.slice(2);
    if (flag === '--apply' && ['plan', 'plan_format'].includes(action)) throw new Error('Apply is unavailable in this offline slice');
    if (['--costClass', '--dryRun'].includes(flag) || !Object.hasOwn(schema.properties, key) || Object.hasOwn(args, key)) throw new Error('Unknown or repeated option');
    if (schema.properties[key].type === 'boolean') {
      if (value !== undefined && !['true', 'false'].includes(value)) throw new Error('Invalid argument');
      args[key] = value !== 'false';
    }
    else if (value !== undefined) args[key] = value;
    else {
      if (!argv.length || argv[0].startsWith('--')) throw new Error(`Missing option value (use ${flag}=VALUE for a value that starts with --)`);
      args[key] = argv.shift();
    }
  }
  const result = execute(action, args);
  console.log(JSON.stringify(result));
  if (result.status === 'blocked' || result.policy?.status === 'blocked') process.exitCode = 2;
} catch (error) {
  console.log(JSON.stringify({ error: error.message })); process.exitCode = 1;
}
